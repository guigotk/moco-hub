<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
 <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarElite" android:layout_width="match_parent" android:layout_height="64dp" app:navigationIcon="@android:drawable/ic_media_previous" app:title="Elite Contracts"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="18dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ranking Elite Contracts" android:textStyle="bold" android:textSize="24sp"/>
  <TextView android:id="@+id/textEliteStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Atualizando dados do CellString…" android:textColor="@color/text_secondary"/>
  <ProgressBar android:id="@+id/progressElite" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"/>
  <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipeElite" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
   <androidx.recyclerview.widget.RecyclerView android:id="@+id/listElite" android:layout_width="match_parent" android:layout_height="match_parent"/>
  </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
 </LinearLayout>
</LinearLayout>
