<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="5dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/divider" app:strokeWidth="1dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
  <TextView android:id="@+id/textEliteRank" android:layout_width="48dp" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="@color/brand" android:textSize="16sp"/>
  <TextView android:id="@+id/textEliteName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textStyle="bold" android:textSize="15sp"/>
  <TextView android:id="@+id/textEliteValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textStyle="bold"/>
 </LinearLayout>
</com.google.android.material.card.MaterialCardView>
